# Base de données PostgreSQL (obligatoire)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventor_studio"

# URL publique de l'application (utilisée par le worker pour le rendu PDF)
APP_URL="http://localhost:3000"

# Stockage : "local" (dossier ./storage) ou "s3"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3_BUCKET=""
# S3_REGION="eu-west-3"
# S3_ENDPOINT=""            # optionnel : MinIO, Cloudflare R2, Scaleway...
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""     # optionnel : CDN devant le bucket

# Clés API IA — uniquement côté serveur, jamais exposées au navigateur
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# Chemin du Chromium utilisé pour l'export PDF (sinon auto-détection)
# CHROMIUM_PATH="/opt/pw-browsers/chromium"

# Jeton d'accès au worker interne (protège les routes /api/internal/*)
INTERNAL_TOKEN="change-me"
