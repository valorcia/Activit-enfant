# Base de données PostgreSQL (obligatoire)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventor_studio"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/inventor_studio"   # connexion directe pour les migrations et pg-boss (Neon : fournie par l'intégration)
# DB_SCHEMA="studio"      # schéma PostgreSQL dédié (défaut « studio » sur Vercel, « public » en local)

# URL publique de l'application (utilisée par le worker pour le rendu PDF)
APP_URL="http://localhost:3000"

# Stockage : "local" (dossier ./storage) ou "s3"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3_BUCKET=""
# S3_REGION="eu-west-3"
# S3_ENDPOINT=""            # optionnel : MinIO, Cloudflare R2, Scaleway...
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""     # optionnel : CDN devant le bucket

# Clés API IA — uniquement côté serveur, jamais exposées au navigateur
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# Chemin du Chromium utilisé pour l'export PDF (sinon auto-détection)
# CHROMIUM_PATH="/opt/pw-browsers/chromium"

# Jeton partagé web ↔ worker (routes /api/internal, rendu PDF des routes /print) — `openssl rand -hex 24`
INTERNAL_TOKEN="change-me"

# Mot de passe d'accès au studio (8 caractères minimum). Vide = aucune protection (local uniquement)
# STUDIO_PASSWORD=""

# Boutique (apps/shop) — publication automatique des e-books (configurable aussi dans Paramètres)
# SHOP_API_URL="https://activite-enfant-shop.vercel.app"
# SHOP_API_KEY=""              # clé créée dans la boutique : Administration → API & automatisation (scopes products:write + products:publish)
