# Worker lancé depuis votre ordinateur contre le studio EN LIGNE : copier en .env.production puis `pnpm worker:prod`
# (ce fichier .env.production est ignoré par git : ne le commitez jamais)

# Même base que le studio Vercel (Neon) — connexion directe pour le worker
DATABASE_URL="postgresql://…-pooler….neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://….neon.tech/neondb?sslmode=require"
DB_SCHEMA="studio"

# URL publique du studio (le worker y charge les routes /print pour produire les PDF)
APP_URL="https://la-malle-a-jeux-studio.vercel.app"
# Identique à la variable INTERNAL_TOKEN du projet Vercel du studio
INTERNAL_TOKEN=""

# Même bucket que le studio en ligne
STORAGE_DRIVER="s3"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT="https://<id-compte>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Clés IA : inutiles en mode copier-coller
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# Chromium local (installé par `npx playwright install chromium` si absent)
# CHROMIUM_PATH=""
