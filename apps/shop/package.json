{
  "name": "shop",
  "version": "0.1.0",
  "private": true,
  "description": "Boutique e-commerce premium : e-books, chasses au trésor et activités à imprimer pour enfants",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "build:vercel": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "build:next": "prisma generate && next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.10.1",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "nanoid": "^6.0.2",
    "next": "^16.4.5",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.37.0",
    "sanitize-html": "^2.18.1",
    "sonner": "^2.0.8",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^18.0.9",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.5",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
