# ---------------------------------------------------------------------------
# Base de données PostgreSQL (Neon, Vercel Postgres, Supabase, RDS…)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shop_dev"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/shop_dev"  # connexion directe pour les migrations (Neon : fournie par l'intégration)

# URL publique du site (sans slash final)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Authentification back-office (Auth.js) — générer avec `openssl rand -base64 32`
# ---------------------------------------------------------------------------
AUTH_SECRET="change-me"
AUTH_TRUST_HOST="true"

# Compte administrateur initial créé par `pnpm db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"

# ---------------------------------------------------------------------------
# Stripe (mode test en développement) — jamais exposé côté client
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ---------------------------------------------------------------------------
# Stockage privé des fichiers (local en dev, S3 compatible en production)
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"            # local | s3
STORAGE_LOCAL_DIR="./storage"
# S3_BUCKET=""
# S3_REGION="eu-west-3"
# S3_ENDPOINT=""                  # Cloudflare R2, Scaleway, MinIO…
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""           # CDN devant le bucket pour les images publiques

# ---------------------------------------------------------------------------
# Emails transactionnels
# ---------------------------------------------------------------------------
EMAIL_DRIVER="console"            # console | resend
# RESEND_API_KEY=""
EMAIL_FROM="Capitaine Coquelicot <bonjour@votre-domaine.fr>"

# Secret de signature des liens de téléchargement (`openssl rand -base64 32`)
DOWNLOAD_TOKEN_SECRET="change-me"

# Jeton pour les tâches planifiées (Vercel Cron : publication programmée, paniers abandonnés)
CRON_SECRET="change-me"

# Analytics / pixels (chargés uniquement après consentement) — configurables aussi dans l'admin
# NEXT_PUBLIC_GA_ID=""
# NEXT_PUBLIC_META_PIXEL_ID=""
# NEXT_PUBLIC_GOOGLE_ADS_ID=""
# NEXT_PUBLIC_PINTEREST_TAG_ID=""
