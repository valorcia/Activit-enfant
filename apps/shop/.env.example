# ---------------------------------------------------------------------------
# Base de données PostgreSQL (Neon, Vercel Postgres, Supabase, RDS…)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shop_dev"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/shop_dev"  # connexion directe pour les migrations (Neon : fournie par l'intégration)

# URL publique du site (sans slash final)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Authentification back-office (Auth.js) — générer avec `openssl rand -base64 32`
# ---------------------------------------------------------------------------
AUTH_SECRET="change-me"
AUTH_TRUST_HOST="true"

# Compte administrateur initial créé par `pnpm db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"

# ---------------------------------------------------------------------------
# Clés d'intégration : FACULTATIVES ici. Elles se saisissent dans
# Administration → Paramètres → Intégrations (chiffrées en base, prioritaires).
# Les variables ci-dessous ne servent que de repli.
# ---------------------------------------------------------------------------
# Stripe (mode test en développement) — jamais exposé côté client
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ---------------------------------------------------------------------------
# Stockage privé des fichiers (local en dev, S3 compatible en production)
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"            # local | s3
STORAGE_LOCAL_DIR="./storage"
# S3_BUCKET=""
# S3_REGION="eu-west-3"
# S3_ENDPOINT=""                  # Cloudflare R2, Scaleway, MinIO…
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""           # CDN devant le bucket pour les images publiques

# ---------------------------------------------------------------------------
# Emails transactionnels
# ---------------------------------------------------------------------------
EMAIL_DRIVER="console"            # console | resend (une clé Resend saisie dans l'admin active l'envoi réel)
# RESEND_API_KEY=""               # facultatif : saisissable dans Admin → Paramètres → Intégrations
EMAIL_FROM="La Malle à Jeux <bonjour@votre-domaine.fr>"

# Secret de signature des liens de téléchargement (`openssl rand -base64 32`)
DOWNLOAD_TOKEN_SECRET="change-me"

# Jeton pour les tâches planifiées (Vercel Cron : publication programmée, paniers abandonnés)
CRON_SECRET="change-me"

# Analytics / pixels (chargés uniquement après consentement) — configurables aussi dans l'admin
# NEXT_PUBLIC_GA_ID=""
# NEXT_PUBLIC_META_PIXEL_ID=""
# NEXT_PUBLIC_GOOGLE_ADS_ID=""
# NEXT_PUBLIC_PINTEREST_TAG_ID=""

# Schéma PostgreSQL des tables de la boutique. Sur Vercel : "shop" par défaut (isolation d'une base partagée) ; "public" pour désactiver.
# DB_SCHEMA="shop"

# ---------------------------------------------------------------------------
# Marketing social (Admin → Marketing social). Toutes facultatives et saisissables dans
# Admin → Paramètres → Intégrations ; sans elles, le module fonctionne en mode dégradé
# (génération + copie manuelle, dépenses saisies à la main).
# ---------------------------------------------------------------------------
# META_APP_ID=""                 # app Meta for Developers (type Business) avec Facebook Login + Instagram Graph API + Marketing API
# META_APP_SECRET=""
# TIKTOK_CLIENT_KEY=""           # app TikTok for Developers (Login Kit + Content Posting API)
# TIKTOK_CLIENT_SECRET=""
# TIKTOK_ADS_ACCESS_TOKEN=""     # jeton TikTok for Business (Marketing API) pour lire les dépenses
# TIKTOK_ADVERTISER_IDS=""       # identifiants annonceur TikTok, séparés par des virgules
# META_CAPI_TOKEN=""             # jeton Conversions API Meta
# TIKTOK_EVENTS_TOKEN=""         # jeton Events API TikTok
# MARKETING_ENCRYPTION_KEY=""    # clé de chiffrement des jetons OAuth et des clés d'intégration (sinon AUTH_SECRET) — `openssl rand -base64 32`.
#                                # Attention : la changer rend illisibles les clés déjà enregistrées (à ressaisir).
# ANTHROPIC_API_KEY=""           # génération des posts par l'API Claude (sinon mode copier-coller)
# OPENAI_API_KEY=""
# RUNWAY_API_KEY=""              # vidéo : animation d'illustrations (image vers vidéo)
# GEMINI_API_KEY=""              # vidéo : Google Veo via l'API Gemini

# Multi-univers (facultatif) : chaque univers est servi sur <slug>.<HUB_DOMAIN> (ex. boutiques.exemple.com)
HUB_DOMAIN=
