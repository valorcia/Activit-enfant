{
  "name": "activit-enfant",
  "private": true,
  "description": "Monorepo : boutique e-commerce (apps/shop) et studio de création (apps/studio)",
  "scripts": {
    "shop": "pnpm --filter shop",
    "studio": "pnpm --filter inventor-studio",
    "dev": "pnpm --filter shop dev",
    "build": "pnpm --filter shop build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "playwright-core"
    ]
  }
}
